# Target
CONFIG_IDF_TARGET="esp32c3"

# Flash: ESP32-C3-MINI-1 has 4 MB in-package flash. Same on DevKitM-1 and the
# custom PCB. DIO is the safe mode for the in-package flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Bluetooth: NimBLE peripheral only (no Bluedroid)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# 1 ms FreeRTOS tick for playback timing (TR-2)
CONFIG_FREERTOS_HZ=1000

# TODO(D6/D9): flash persistence, power management, advertising interval
